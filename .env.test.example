# Copy this file to .env.test.local for local-only Playwright tests.
# Start a disposable local Supabase instance first, then replace both keys
# with the values printed by `supabase status -o env`.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-local-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=replace-with-local-supabase-service-role-key
